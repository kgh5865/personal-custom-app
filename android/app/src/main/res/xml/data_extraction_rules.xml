<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 이상(API 31+) 백업/기기이전 규칙. backup_rules.xml 과 같은 이유로
  암호화 저장소를 제외한다. 키가 Keystore 에 묶여 있어 옮겨가도 못 읽는다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="SecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="SecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
